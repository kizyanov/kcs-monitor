# Пример окружения kcs-monitor: cp .env.example .env
# Приложение само читает .env (dotenvy); переменные окружения имеют приоритет.

# Пауза между свипами, секунды (600 = раз в 10 минут).
# 0 = один проход и выход — для запуска по cron/systemd timer.
KCS_INTERVAL_SECONDS=600

# Глубина ПЕРВОГО свипа процесса — первичная загрузка истории.
# 0 = как обычный свип.
KCS_BARS_FIRST=100

# Глубина обычных свипов (часовой ритм — достаточно 3 баров).
# Повторная загрузка тех же баров ничего не перезаписывает (идемпотентно).
KCS_BARS=3

# Максимум одновременных REST-запросов к бирже.
KCS_CONCURRENCY=8

# Биржа и таймфреймы
# KCS_EXCHANGE=kucoin
# KCS_KLINE_INTERVALS=1hour,4hour,1day,1week
# KCS_API_BASE=https://api.kucoin.com

# Отладка: ограничить список пар (пусто = все торгуемые)
# KCS_SYMBOLS=BTC-USDT,ETH-USDT

# База данных; без неё свечи печатаются JSON-строками в stdout.
# KCS_DATABASE_URL — алиас (у него приоритет).
DATABASE_URL=postgres://cryptodb:CHANGE_ME@127.0.0.1:5433/cryptodb
